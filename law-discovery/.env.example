# AI provider (required only for AI-assisted commands)
LAW_DISCOVERY_AI_PROVIDER=litellm
# Must be a model_name alias in your LiteLLM config (law-proposition-extractor/config/litellm.yaml)
LAW_DISCOVERY_AI_MODEL=law-discovery-fast

# LiteLLM OpenAI-compatible proxy (restart `just litellm` after config changes)
LAW_DISCOVERY_LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LAW_DISCOVERY_LITELLM_API_KEY=sk-local-dev

# Lex API / Lex Graph (required only for live network discovery)
LAW_DISCOVERY_LEX_BASE_URL=https://lex.example.defra.gov.uk
LAW_DISCOVERY_LEX_API_KEY=
