OPENAI_API_KEY=
LITELLM_MASTER_KEY=lpe-dev-key

LAW_PROPOSITION_EXTRACTOR_LLM_BASE_URL=http://127.0.0.1:4000/v1
LAW_PROPOSITION_EXTRACTOR_LLM_API_KEY=lpe-dev-key

LAW_PROPOSITION_EXTRACTOR_MODEL_LOCAL_EXTRACT=local_extract
LAW_PROPOSITION_EXTRACTOR_MODEL_LOCAL_CLASSIFY=local_classify
LAW_PROPOSITION_EXTRACTOR_MODEL_FRONTIER_REASON=frontier_reason
LAW_PROPOSITION_EXTRACTOR_MODEL_FRONTIER_WRITEUP=frontier_writeup

LAW_PROPOSITION_EXTRACTOR_DATABASE_URL=sqlite:///./law-proposition-extractor.db

# Next.js (apps/web): optional absolute path to the API ops export root — enables
# proposition explorer “repair failed extraction chunks” (must match the server’s export dir).
# NEXT_PUBLIC_LAW_PROPOSITION_EXTRACTOR_OPS_EXPORT_DIR=

# Optional: browser origins the API allows for CORS (comma-separated). Defaults cover
# localhost/127.0.0.1 on ports 3000–3001 for Next.js dev (including port fallback).
# CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
