title: |md
  **Law Proposition Extractor system map** — Law Discovery finds sources; Law Proposition Extractor models rules; humans review; Proposition Matcher compares guidance
|
title.style.font-size: 16

sources: {
  label: "External source authorities"
  style.fill: "#F8FAFC"
  style.stroke: "#94A3B8"

  leg: "legislation.gov.uk"
  leg.class: external
  eur: "EUR-Lex"
  eur.class: external
}

law-discovery: "[Law Discovery] Source register\nfinds and registers sources"
law-discovery.class: system

intake: "Law Proposition Extractor intake and source capture\nconsumes source snapshots"
intake.class: system

pipeline: "Law Proposition Extractor proposition and\nlegal-structure pipeline\nmodels legal rules from snapshots"
pipeline.class: system

divergence: "[optional] Law Proposition Extractor divergence branch\nproposition / effective-law comparison"
divergence.class: optional

workbench: "Review Workbench\nhuman review of legal structure\nand decision explanations"
workbench.class: system

reviewers: "Reviewers (human)"
reviewers.class: human

reviewed: "Reviewed effective-law output\n(reviewed — not automatically authoritative)"
reviewed.class: reviewed

proposition-matcher: "Proposition Matcher guidance comparison\ncompares reviewed law with guidance"
proposition-matcher.class: system

boundary: |md
  **Boundary:** Neither Law Proposition Extractor nor Proposition Matcher independently publishes law without review.
|
boundary.class: note

sources.leg -> law-discovery: "discovered URIs"
sources.eur -> law-discovery: "discovered URIs"
law-discovery -> intake: "registered sources"
intake -> pipeline
pipeline -> workbench
pipeline -> divergence: "optional"
divergence -> workbench: "optional findings"
reviewers -> workbench: "review verdicts"
workbench -> reviewed: "after human review"
reviewed -> proposition-matcher: "reviewed law only"
boundary -> reviewed
