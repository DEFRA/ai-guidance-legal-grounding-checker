mechanisms: {
  label: "Divergence mechanisms (status from committed manifest)"
  class: section

  textual: "[IMPL] textual"
  textual.class: status_implemented

  structural: "[IMPL] structural"
  structural.class: status_implemented

  dynamic_reference: "[PLANNED] dynamic-reference"
  dynamic_reference.class: status_planned

  territorial: "[PLANNED] territorial"
  territorial.class: status_planned

  institutional: "[IMPL] institutional"
  institutional.class: status_implemented

  procedural: "[IMPL] procedural"
  procedural.class: status_implemented

  annex_model_certificate: "[IMPL] annex/model/certificate"
  annex_model_certificate.class: status_implemented

  definitional: "[IMPL] definitional"
  definitional.class: status_implemented

  revocation_replacement: "[PLANNED] revocation/replacement"
  revocation_replacement.class: status_planned

}

workflow_status: {
  label: "Workflow stage status"
  class: section

  wf_source_snapshots: "[IMPL] source snapshots"
  wf_source_snapshots.class: status_implemented

  wf_propositions: "[IMPL] propositions"
  wf_propositions.class: status_implemented

  wf_effective_law_statements: "[IMPL] effective-law statements"
  wf_effective_law_statements.class: status_implemented

  wf_baseline_current_alignment: "[PARTIAL] baseline/current alignment"
  wf_baseline_current_alignment.class: status_partially_implemented

  wf_unchanged_rules_removed: "[PARTIAL] unchanged rules removed"
  wf_unchanged_rules_removed.class: status_partially_implemented

  wf_candidate_divergence: "[IMPL] candidate divergence"
  wf_candidate_divergence.class: status_implemented

  wf_scope_resolution_review: "[PLANNED] scope-resolution review"
  wf_scope_resolution_review.class: status_planned

  wf_divergence_review: "[PARTIAL] divergence review"
  wf_divergence_review.class: status_partially_implemented

  wf_guidance_eligibility: "[PLANNED] guidance eligibility"
  wf_guidance_eligibility.class: status_planned

  wf_beatrice_comparison: "[PARTIAL] Proposition Matcher comparison"
  wf_beatrice_comparison.class: status_partially_implemented

}

mechanisms -> workflow_status: "same status legend"
# END GENERATED: divergence-status-data

families -> process
