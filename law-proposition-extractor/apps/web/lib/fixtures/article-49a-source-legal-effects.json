  "propositions": [
    {
      "id": "prop-demo-49a-p1-separate",
      "source_record_id": "src-demo-1224",
      "source_snapshot_id": "snap-demo-1224-revised",
      "source_fragment_id": "frag-demo-49a-p1",
      "fragment_locator": "article:49a:paragraph:1",
      "proposition_text": "Catches below the applicable minimum conservation reference size shall be kept separately identifiable."
    },
    {
      "id": "prop-demo-49a-p1-no-mixing",
      "source_record_id": "src-demo-1224",
      "source_snapshot_id": "snap-demo-1224-revised",
      "source_fragment_id": "frag-demo-49a-p1",
      "fragment_locator": "article:49a:paragraph:1",
      "proposition_text": "Those catches shall not be mixed with any other fishery products."
    },
    {
      "id": "prop-demo-49a-p2-pelagic",
      "source_record_id": "src-demo-1224",
      "source_snapshot_id": "snap-demo-1224-revised",
      "source_fragment_id": "frag-demo-49a-p2",
      "fragment_locator": "article:49a:paragraph:2",
      "proposition_text": "Paragraph 1 shall not apply where the catches contain more than 80% of small pelagic species."
    },
    {
      "id": "prop-demo-49a-p3-monitoring",
      "source_record_id": "src-demo-1224",
      "source_snapshot_id": "snap-demo-1224-revised",
      "source_fragment_id": "frag-demo-49a-p3",
      "fragment_locator": "article:49a:paragraph:3",
      "proposition_text": "A fisheries administration must monitor the catch composition by way of sampling."
    }
  ],
