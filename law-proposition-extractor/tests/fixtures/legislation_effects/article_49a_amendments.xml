  <Title>Council Regulation (EC) No 1224/2009</Title>
  <EURetained>
    <EUBody>
      <P1group>
        <Title><Addition ChangeId="O003001M119" CommentaryRef="c000004">Separate stowage of catches below the minimum conservation reference sizes</Addition></Title>
        <P1 DocumentURI="http://www.legislation.gov.uk/eur/2009/1224/article/49a"
             IdURI="http://www.legislation.gov.uk/id/eur/2009/1224/article/49a"
             id="article-49a">
          <Pnumber><Addition ChangeId="O003001M119" CommentaryRef="c000004">Article 49a</Addition></Pnumber>
          <P1para>
            <P2 DocumentURI="http://www.legislation.gov.uk/eur/2009/1224/article/49a/1"
                IdURI="http://www.legislation.gov.uk/id/eur/2009/1224/article/49a/1"
                id="article-49a-1">
              <Pnumber PuncBefore="" PuncAfter="."><Addition ChangeId="O003001M119" CommentaryRef="c000004">1</Addition></Pnumber>
              <P2para>
                <Text>
                  <Addition ChangeId="O003001M119" CommentaryRef="c000004">All catches below the applicable minimum conservation reference size retained on board a </Addition>
                  <Addition ChangeId="O003001M119" CommentaryRef="c000004">
                    <Substitution ChangeId="key-ae688d7efb8d525f494201f970bc3e75-1691666974278"
                                  CommentaryRef="key-ae688d7efb8d525f494201f970bc3e75">United Kingdom</Substitution>
                  </Addition>
                  <Addition ChangeId="O003001M119" CommentaryRef="c000004"> fishing vessel shall be placed in boxes.</Addition>
                </Text>
              </P2para>
            </P2>
            <P2 DocumentURI="http://www.legislation.gov.uk/eur/2009/1224/article/49a/2"
                IdURI="http://www.legislation.gov.uk/id/eur/2009/1224/article/49a/2"
                id="article-49a-2">
              <Pnumber PuncBefore="" PuncAfter="."><Addition ChangeId="O003001M119" CommentaryRef="c000004">2</Addition></Pnumber>
              <P2para>
                <Text>
                  <Addition ChangeId="O003001M119" CommentaryRef="c000004">Paragraph 1 shall not apply where </Addition>
                  <Addition ChangeId="O003001M119" CommentaryRef="c000004">
                    <Substitution ChangeId="key-cd016a627475b52260f225a4d4ac7ed7-1691666994520"
                                  CommentaryRef="key-cd016a627475b52260f225a4d4ac7ed7">catches contain more than 80%</Substitution>
                  </Addition>
                  <Addition ChangeId="O003001M119" CommentaryRef="c000004"> of listed species.</Addition>
                </Text>
              </P2para>
            </P2>
            <P2 DocumentURI="http://www.legislation.gov.uk/eur/2009/1224/article/49a/3"
                IdURI="http://www.legislation.gov.uk/id/eur/2009/1224/article/49a/3"
                id="article-49a-3">
              <Pnumber PuncBefore="" PuncAfter="."><Addition ChangeId="O003001M119" CommentaryRef="c000004">3</Addition></Pnumber>
              <P2para>
                <Text>
                  <Addition ChangeId="O003001M119" CommentaryRef="c000004">In the cases referred to in paragraph 2, </Addition>
                  <Addition ChangeId="O003001M119" CommentaryRef="c000004">
                    <Substitution ChangeId="key-c36fcfcb069fb8c51fce93fbce7ea03b-1691667010551"
                                  CommentaryRef="key-c36fcfcb069fb8c51fce93fbce7ea03b">a fisheries administration must</Substitution>
                  </Addition>
                  <Addition ChangeId="O003001M119" CommentaryRef="c000004"> monitor the catch composition by way of sampling.</Addition>
                </Text>
              </P2para>
            </P2>
          </P1para>
        </P1>
      </P1group>
    </EUBody>
