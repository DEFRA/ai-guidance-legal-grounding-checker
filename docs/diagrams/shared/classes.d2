# Shared visual classes for repo-level Guidance to Law Comparison diagrams.
# Import from a diagram with: ...@../shared/classes.d2  (adjust relative path)

classes: {
  person: {
    style: {
      fill: "#F0F9FF"
      stroke: "#0369A1"
      stroke-width: 2
      border-radius: 8
    }
  }
  system: {
    style: {
      fill: "#EEF2FF"
      stroke: "#4338CA"
      stroke-width: 2
      border-radius: 8
    }
  }
  step: {
    style: {
      fill: "#FFFFFF"
      stroke: "#64748B"
      border-radius: 8
    }
  }
  process: {
    style: {
      fill: "#FFFFFF"
      stroke: "#4338CA"
      stroke-width: 2
      border-radius: 8
    }
  }
  artefact: {
    style: {
      fill: "#ECFDF5"
      stroke: "#059669"
      stroke-width: 1
      border-radius: 8
    }
  }
  container: {
    style: {
      fill: "#FFFFFF"
      stroke: "#4338CA"
      stroke-width: 1
      border-radius: 8
    }
  }
  datastore: {
    style: {
      fill: "#FFFBEB"
      stroke: "#B45309"
      stroke-width: 2
      border-radius: 8
    }
  }
  external: {
    style: {
      fill: "#F8FAFC"
      stroke: "#64748B"
      stroke-dash: 3
      border-radius: 8
    }
  }
  path: {
    style: {
      fill: "#F8FAFC"
      stroke: "#CBD5E1"
      stroke-width: 1
      border-radius: 12
    }
  }
  merge: {
    style: {
      fill: "#ECFDF5"
      stroke: "#059669"
      stroke-width: 2
      border-radius: 8
    }
  }
  phase: {
    style: {
      fill: "#F8FAFC"
      stroke: "#94A3B8"
      stroke-width: 1
      border-radius: 12
    }
  }
}
